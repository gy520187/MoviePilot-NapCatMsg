# MoviePilot 超级管理员用户名
MOVIEPILOT_SUPERUSER=admin

# MoviePilot API令牌，建议改成随机长字符串
MOVIEPILOT_API_TOKEN=please-change-me

# TMDB API Key（可选）
TMDB_API_KEY=

# 机器人QQ号（可选）
NAPCAT_ACCOUNT=

# NapCat WebUI 登录令牌（进 WebUI 管理页用，固定后重启不再变化）
NAPCAT_WEBUI_TOKEN=change-me-to-a-random-token

# OneBot 鉴权令牌在 NapCat WebUI「网络配置」中设置，与插件 AccessToken 一致（见 README）
